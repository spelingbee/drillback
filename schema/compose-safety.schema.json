{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/spelingbee/drillback/schema/compose-safety.schema.json",
  "title": "drillback compose safety rules",
  "description": "An allow-list, not a deny-list. A compose key that drillback has not thought about is rejected, because the compose specification grows and a deny-list loses to it silently. See DECISIONS.md ADR-057.",
  "type": "object",
  "required": ["services", "networks"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "description": "Ignored: drillback names the compose project itself, per run."
    },
    "services": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["image", "networks"],
        "additionalProperties": false,
        "properties": {
          "image": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._/-]*(:[A-Za-z0-9._-]+)?(@sha256:[a-f0-9]{64})?$",
            "not": { "pattern": ":latest$" },
            "description": "Pinned tag required. `latest` makes a recipe untestable over time."
          },
          "command": true,
          "entrypoint": true,
          "environment": true,
          "user": { "type": ["string", "number"] },
          "working_dir": { "type": "string" },
          "hostname": { "type": "string" },
          "depends_on": true,
          "healthcheck": true,
          "profiles": { "type": "array", "items": { "type": "string" } },
          "labels": true,
          "restart": { "enum": ["no", "always", "on-failure", "unless-stopped"] },
          "stop_grace_period": { "type": "string" },
          "stop_signal": { "type": "string" },
          "init": { "type": "boolean" },
          "read_only": { "type": "boolean" },
          "expose": true,
          "platform": { "type": "string" },
          "shm_size": { "type": ["string", "number"] },
          "mem_limit": { "type": ["string", "number"] },
          "cpus": { "type": ["string", "number"] },
          "pids_limit": { "type": ["string", "number"] },
          "tmpfs": true,
          "networks": true,
          "cap_drop": { "type": "array", "items": { "type": "string" } },
          "cap_add": {
            "type": "array",
            "items": { "enum": ["CHOWN", "DAC_OVERRIDE", "FOWNER", "SETGID", "SETUID"] },
            "description": "Allowlist. Anything outside it, and NET_ADMIN / SYS_ADMIN in particular, is rejected."
          },
          "volumes": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^(\\$\\{DRILLBACK_(INPUT|TEST_ASSETS|EXPORT)[A-Za-z0-9_]*\\}|[a-z][a-z0-9_-]*):/[^:]+(:(ro|rw|z|Z|ro,z|rw,z))?$",
                  "description": "Left side must be a named volume declared in this file, or a ${DRILLBACK_*} placeholder that drillback resolves inside the workspace. An absolute host path is rejected."
                },
                {
                  "type": "object",
                  "required": ["type", "target"],
                  "additionalProperties": false,
                  "properties": {
                    "type": { "enum": ["volume", "tmpfs"] },
                    "source": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
                    "target": { "type": "string", "pattern": "^/" },
                    "read_only": { "type": "boolean" },
                    "volume": { "type": "object" },
                    "tmpfs": { "type": "object" }
                  },
                  "description": "Long syntax may not use type: bind. Bind mounts are only expressible through the ${DRILLBACK_*} short form, which drillback controls."
                }
              ]
            }
          },
          "security_opt": {
            "type": "array",
            "items": { "not": { "pattern": "(?i)(seccomp[:=]unconfined|apparmor[:=]unconfined|systempaths=unconfined)" } }
          }
        }
      }
    },
    "networks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["internal"],
        "additionalProperties": false,
        "properties": {
          "internal": { "const": true },
          "external": { "const": false },
          "labels": true,
          "name": { "type": "string" },
          "driver": { "const": "bridge" },
          "attachable": { "type": "boolean" }
        }
      }
    },
    "volumes": {
      "type": "object",
      "description": "Named volumes only. `driver_opts` with type=none,o=bind turns a name that looks like a named volume into a bind mount of any host path, which is the isolation rule restated as its own bypass.",
      "additionalProperties": {
        "type": ["object", "null"],
        "additionalProperties": false,
        "properties": {
          "labels": true,
          "name": { "type": "string" }
        }
      }
    }
  }
}
